{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && data.child('hostId').val() === auth.uid))",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",

        "hostId": {
          ".write": "auth != null && newData.val() === auth.uid && data.parent().child('players/' + auth.uid + '/online').val() === true && data.parent().child('players/' + data.val() + '/online').val() !== true"
        },

        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostId').exists()",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 16" },
            "b": {
              ".validate": "newData.hasChildren(['x', 'y', 'l'])",
              "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400" },
              "l": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
              "$other": { ".validate": false }
            }
          }
        },

        "pops": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('hostId').exists() && data.parent().parent().child('status').val() === 'playing'",
            "$key": {
              ".validate": "newData.hasChildren(['x', 'y', 'l', 's', 't', 'r']) && newData.child('t').val() >= data.parent().parent().parent().child('startAt').val() && newData.child('t').val() <= data.parent().parent().parent().child('endsAt').val() + 2000",
              "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 400" },
              "l": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
              "s": { ".validate": "newData.isNumber()" },
              "t": { ".validate": "newData.isNumber() && newData.val() <= now + 5000" },
              "r": { ".validate": "newData.isNumber() && newData.val() === data.parent().parent().parent().parent().child('round').val()" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
